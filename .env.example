APP_CONFIG=development
FLASK_ENV=development
SECRET_KEY=change-me-to-a-random-secret

# Paths (relative paths are resolved from project root)
INSTANCE_PATH=instance
DATA_DIR=instance
UPLOAD_FOLDER=instance/uploads/attachments

# Database examples:
# SQLite (default fallback if DATABASE_URL is empty)
DATABASE_URL=sqlite:///instance/letter_tracker.db
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg2://cm_user:strong_password@10.0.0.10:5432/case_management

# Flask-Limiter backend (use Redis in production for multi-process correctness)
RATELIMIT_STORAGE_URI=memory://
# Example:
# RATELIMIT_STORAGE_URI=redis://10.0.0.11:6379/0

HOST=127.0.0.1
PORT=5001
SERVER_MODE=flask
WEB_THREADS=8
AUTO_DB_BOOTSTRAP=true

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@example.com
ADMIN_FULLNAME=ROC Administrator
