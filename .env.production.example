APP_CONFIG=production
FLASK_ENV=production
SECRET_KEY=replace-with-a-long-random-secret

# Keep data outside code deployment directory in production
INSTANCE_PATH=/var/lib/case-management/instance
DATA_DIR=/var/lib/case-management/data
UPLOAD_FOLDER=/var/lib/case-management/data/uploads/attachments

# PostgreSQL (recommended for production)
DATABASE_URL=postgresql+psycopg2://cm_user:strong_password@127.0.0.1:5432/case_management

# Optional: Redis backend for rate limiting in multi-process / multi-instance setups
# RATELIMIT_STORAGE_URI=redis://127.0.0.1:6379/0
RATELIMIT_STORAGE_URI=memory://

HOST=127.0.0.1
PORT=5001
SERVER_MODE=waitress
WEB_THREADS=8
AUTO_DB_BOOTSTRAP=false

# Optional admin seed values for first-time setup workflows
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_EMAIL=admin@example.com
ADMIN_FULLNAME=ROC Administrator
